POSTGRES_DB=tang_course_platform
POSTGRES_USER=tang_course_app
POSTGRES_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
COMPOSE_FILE=compose.server.yaml

JWT_SECRET_KEY=CHANGE_TO_A_LONG_RANDOM_ACCESS_TOKEN_SECRET
JWT_REFRESH_SECRET_KEY=CHANGE_TO_ANOTHER_LONG_RANDOM_REFRESH_SECRET

# 前端使用同域名 /api，避免额外跨域配置。
PUBLIC_API_URL=/api
PUBLIC_IMAGE_BASE_URL=

# 未配置对象存储时，除图片上传外的功能仍可使用。
R2_ACCESS_KEY=disabled
R2_SECRET_KEY=disabled
R2_BUCKET_NAME=course-pics
R2_ENDPOINT=http://127.0.0.1:9000
R2_REGION=auto
R2_PUBLIC_URL=

# 低资源服务器默认限制，可按服务器规格调整。
BACKEND_MEMORY_LIMIT=512m
FRONTEND_MEMORY_LIMIT=256m
POSTGRES_MEMORY_LIMIT=256m
